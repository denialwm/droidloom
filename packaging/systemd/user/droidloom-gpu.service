[Unit]
Description=Droidloom GPU server: Android Vulkan on the host driver
PartOf=droidloom.service
Requires=droidloom-gpu.socket

[Service]
# Started by the first Android Vulkan client; forks one server per client.
# Setup names the GPU there (DROIDLOOM_GPU): pacman installs and source
# installs keep it in different files.
EnvironmentFile=-/etc/droidloom/runtime.env
EnvironmentFile=-/usr/lib/environment.d/60-droidloom.conf
ExecStart=/usr/bin/droidloom-gpu-server
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
RestrictSUIDSGID=true
