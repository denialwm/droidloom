[Unit]
Description=Droidloom Android application runtime
PartOf=graphical-session.target
After=graphical-session-pre.target wayland-session-waitenv.service
Wants=droidloom-applications.service droidloom-audio.socket droidloom-gpu.socket droidloom-recovery.service
After=droidloom-audio.socket droidloom-gpu.socket
ConditionPathExists=/etc/droidloom/cell.json

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/usr/lib/environment.d/60-droidloom.conf
Environment=DROIDLOOM_MODE=desktop
EnvironmentFile=-%t/droidloom/session.env
ExecStartPre=/usr/bin/systemctl start droidloomd.service
ExecStart=/usr/bin/droidloom-wayland
ExecStartPost=/usr/bin/droidloomctl start --cell
# The daemon owns cell teardown; signal it directly so busy RPCs can cancel.
ExecStopPost=/usr/bin/systemctl stop droidloomd.service
Restart=on-failure
RestartSec=1
TimeoutStartSec=150
TimeoutStopSec=150

[Install]
WantedBy=graphical-session.target
