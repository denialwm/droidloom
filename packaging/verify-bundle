#!/usr/bin/env python3
"""Seal and verify complete Droidloom payloads without executing target binaries."""
import argparse
import hashlib
import json
import pathlib
import re
import stat
import sys
import zipfile

MANIFEST = 'droidloom-bundle.json'
MARKER = re.compile(rb'DROIDLOOM_INPUT_ABI=([0-9]{1,5});')
RUNTIME = pathlib.Path('usr/lib/droidloom/runtime')
COMPOSER = RUNTIME / 'bin/android.hardware.graphics.composer3-service.droidloom'
POLICY_JAR = RUNTIME / 'framework/services.jar'
POLICY_NATIVE = RUNTIME / 'lib64/libinputflinger.so'
POLICY_ABI = b'DROIDLOOM_WINDOW_POLICY_ABI=1;'
TASK_ABI = b'DROIDLOOM_TASK_BACKEND_ABI=3;'
NATIVE_INPUT_ABI = b'DROIDLOOM_NATIVE_INPUT_ABI=2;'
CHANNELS_ABI = b'DROIDLOOM_HOST_CHANNELS_ABI=1;'
DIRECT_INPUT_ABI = b'DROIDLOOM_DIRECT_INPUT_ABI=1;'
FRAMEWORK_ABI = b'DROIDLOOM_FRAMEWORK_CONTROL_ABI=1;'
NOTIFICATIONS_ABI = b'DROIDLOOM_NOTIFICATIONS_ABI=2;'


def abi(data, label):
    versions = {int(v) for v in MARKER.findall(data)}
    if len(versions) != 1:
        raise ValueError(f'{label}: missing or ambiguous build compatibility metadata; rebuild this component')
    return versions.pop()


def dex(path):
    with zipfile.ZipFile(path) as archive:
        return b''.join(archive.read(n) for n in archive.namelist()
                        if n.startswith('classes') and n.endswith('.dex'))


def compatibility(root):
    binary = (root / COMPOSER).read_bytes()
    if binary[:4] != b'\x7fELF' or len(binary) < 20 or binary[5] != 1:
        raise ValueError('Composer must be a little-endian ELF executable')
    machine = int.from_bytes(binary[18:20], 'little')
    arch = {62: 'x86_64', 183: 'aarch64'}.get(machine)
    if not arch:
        raise ValueError(f'unsupported Composer ELF architecture: {machine}')
    sender = abi(binary, str(COMPOSER))
    if (DIRECT_INPUT_ABI not in binary or DIRECT_INPUT_ABI not in
            (root / 'usr/bin/droidloom-wayland').read_bytes()):
        raise ValueError('Composer and presenter lack paired direct input ABI 1')
    with zipfile.ZipFile(root / POLICY_JAR) as archive:
        policy_java = b''.join(archive.read(n) for n in archive.namelist()
                               if n.startswith('classes') and n.endswith('.dex'))
    policy_native = (root / POLICY_NATIVE).read_bytes()
    if POLICY_ABI not in policy_java or POLICY_ABI not in policy_native:
        raise ValueError('services.jar and libinputflinger.so lack paired Rust window policy ABI 1')
    if (policy_native[:6] != b'\x7fELF\x02\x01'
            or int.from_bytes(policy_native[18:20], 'little') != machine):
        raise ValueError('wrong Rust window policy JNI architecture')
    if TASK_ABI not in policy_java or TASK_ABI not in policy_native:
        raise ValueError('framework pair lacks task backend ABI 3')
    if TASK_ABI not in binary:
        raise ValueError('Composer lacks task backend ABI 3')
    if any(NATIVE_INPUT_ABI not in data for data in [policy_java, policy_native, binary]):
        raise ValueError('framework pair lacks native input ABI 2')
    native_input = abi(policy_native, str(POLICY_NATIVE))
    if native_input != sender:
        raise ValueError(f'input protocol mismatch: Composer v{sender}, InputFlinger v{native_input}')
    if b'Lcom/android/server/wm/DroidloomApplicationCatalog;' not in policy_java:
        raise ValueError('in-process application catalog class is missing')
    if any(FRAMEWORK_ABI not in data for data in [policy_java, policy_native,
            (root / 'usr/bin/droidloomd').read_bytes(), (root / 'usr/bin/droidloom-applications').read_bytes()]):
        raise ValueError('framework/native/lifecycle/catalog peers lack framework control ABI 1')
    if any(NOTIFICATIONS_ABI not in data for data in [dex(root / RUNTIME / 'systemui/SystemUI.apk'),
            (root / 'usr/bin/droidloom-wayland').read_bytes()]):
        raise ValueError('SystemUI/presenter lack notification delta ABI 2')
    for artifact in [POLICY_JAR, RUNTIME / 'systemui/SystemUI.apk', RUNTIME / 'ime/DroidloomIME.apk']:
        if CHANNELS_ABI not in dex(root / artifact):
            raise ValueError(f'{artifact}: missing direct host channels ABI 1')
    if CHANNELS_ABI not in (root / 'usr/bin/droidloom-wayland').read_bytes():
        raise ValueError('presenter lacks direct host channels ABI 1')
    for retired in ['droidloom-input-bridge', 'droidloom-input-bridge.jar', 'droidloom-input-bridge.rc',
                    'droidloom-task-launcher', 'libdroidloom_task_launcher.dylib.so', 'droidloom-application-catalog.jar']:
        if any((root / RUNTIME).rglob(retired)):
            raise ValueError('retired support artifact remains in payload')
    for name in ['droidloomd', 'droidloomctl', 'droidloom-supervisor',
                 'droidloom-wayland', 'droidloom-applications', 'droidloom-audio', 'droidloom-gpu-server',
                 'droidloom-devices']:
        with (root / 'usr/bin' / name).open('rb') as source:
            header = source.read(20)
        if header[:4] != b'\x7fELF' or header[5:6] != b'\x01' or int.from_bytes(header[18:20], 'little') != machine:
            raise ValueError(f'{name}: host and Android architectures do not match')
    return {'architecture': arch, 'input_protocol': sender}


def inventory(root):
    result = {}
    for path in sorted(root.rglob('*')):
        relative = str(path.relative_to(root))
        if relative == MANIFEST:
            continue
        mode = path.lstat().st_mode
        if stat.S_ISLNK(mode):
            # Do not let checksums follow input paths outside the package.
            if not path.resolve().is_relative_to(root.resolve()) or not path.exists():
                raise ValueError(f'unsafe or dangling package symlink: {relative}')
            result[relative] = {'link': str(path.readlink())}
        elif stat.S_ISREG(mode):
            with path.open('rb') as source:
                digest = hashlib.file_digest(source, 'sha256').hexdigest()
            result[relative] = {'sha256': digest, 'mode': stat.S_IMODE(mode)}
        elif not stat.S_ISDIR(mode):
            raise ValueError(f'unsupported package file type: {relative}')
    return result


def seal(root):
    # Read ABI claims from the compiled artifacts, never from today's sources.
    contract = compatibility(root)
    manifest = {'schema': 1, 'compatibility': contract, 'files': inventory(root)}
    (root / MANIFEST).write_text(json.dumps(manifest, indent=2, sort_keys=True) + '\n')
    return contract


def verify(root):
    manifest = json.loads((root / MANIFEST).read_text())
    if set(manifest) != {'schema', 'compatibility', 'files'} or manifest['schema'] != 1:
        raise ValueError('unsupported bundle manifest')
    actual = inventory(root)
    if actual != manifest['files']:
        changed = sorted(k for k in set(actual) | set(manifest['files'])
                         if actual.get(k) != manifest['files'].get(k))
        raise ValueError('bundle files changed after sealing: ' + ', '.join(changed[:8]))
    contract = compatibility(root)
    if contract != manifest['compatibility']:
        raise ValueError('bundle compatibility metadata disagrees with compiled artifacts')
    return contract


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation', choices=['seal', 'verify'])
    parser.add_argument('payload', type=pathlib.Path)
    args = parser.parse_args()
    try:
        contract = (seal if args.operation == 'seal' else verify)(args.payload.resolve())
    except (OSError, ValueError, KeyError, zipfile.BadZipFile) as error:
        parser.exit(1, f'Droidloom bundle rejected: {error}\n')
    print(json.dumps(contract, sort_keys=True))


if __name__ == '__main__':
    main()
