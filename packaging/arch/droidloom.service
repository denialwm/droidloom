[Unit]
Description=Droidloom Android application runtime
PartOf=graphical-session.target
After=graphical-session-pre.target
Wants=droidloom-applications.service droidloom-audio.socket droidloom-gpu.socket droidloom-devices.socket droidloom-recovery.service
After=droidloom-audio.socket droidloom-gpu.socket droidloom-devices.socket
ConditionPathExists=/etc/droidloom/cell.json

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/droidloom/runtime.env
Environment=DROIDLOOM_MODE=desktop
EnvironmentFile=-%t/droidloom/session.env
ExecStartPre=/usr/bin/systemctl start droidloomd.service
ExecStart=/usr/bin/droidloom-wayland
ExecStartPost=/usr/bin/droidloomctl start --cell
ExecStopPost=-/usr/bin/droidloomctl stop --cell
ExecStopPost=/usr/bin/systemctl stop droidloomd.service
Restart=on-failure
RestartSec=1
TimeoutStartSec=150
TimeoutStopSec=150

[Install]
WantedBy=graphical-session.target
