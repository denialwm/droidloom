# All build and filesystem work is implemented by the Rust package command.
pkgbase=droidloom
pkgname=(droidloom-runtime droidloom-image)
pkgver=@VERSION@
pkgrel=@RELEASE@
arch=(x86_64 aarch64)
pkgdesc='Android applications in native Wayland windows'
url='https://github.com/denialwm/droidloom'
license=(GPL-3.0-or-later)
options=(!strip !debug !lto !purge)
makedepends=(rustup git rsync curl unzip zip meson ninja pkgconf llvm clang glslang
  spirv-llvm-translator bison flex android-tools erofs-utils e2fsprogs
  python python-yaml python-mako ccache mesa libdrm wayland libxkbcommon libpipewire)

build() {
  "$DROIDLOOM_PACKAGE_TOOL" compile --source "$DROIDLOOM_SOURCE" \
    --work "$DROIDLOOM_WORK" --destination "$srcdir/payload" --jobs "$DROIDLOOM_JOBS"
}

package_droidloom-runtime() {
  depends=("droidloom-image=$pkgver-$pkgrel" glibc gcc-libs mesa libdrm wayland
    libxkbcommon libpipewire pipewire systemd polkit util-linux e2fsprogs iproute2 nftables iptables android-tools)
  optdepends=('wireplumber: automatic host audio routing (or another PipeWire session manager)')
  "$DROIDLOOM_PACKAGE_TOOL" install-tree --source "$srcdir/payload/runtime" --destination "$pkgdir"
}

package_droidloom-image() {
  pkgdesc='Android system and Droidloom Android components'
  license=(GPL-3.0-or-later LicenseRef-Android LicenseRef-Mesa)
  "$DROIDLOOM_PACKAGE_TOOL" install-tree --source "$srcdir/payload/image" --destination "$pkgdir"
}
