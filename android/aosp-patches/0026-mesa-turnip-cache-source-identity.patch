turnip: key the pipeline cache by Mesa's source, not the build-id

turnip derived pipelineCacheUUID, and with it its own disk cache and every
application's VkPipelineCache, from the build-id of the library. Droidloom's
Mesa builds are not reproducible, so each rebuild of the same source threw
away the pipelines ANGLE keeps for games and Wuthering Waves compiled them
again. The UUID now hashes the same source identity as the ir3 shader cache.

diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 34bc2f3..41edf98 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -27,6 +27,7 @@
 #include "vk_util.h"
 
 #include "common/freedreno_uuid.h"
+#include "ir3/droidloom_mesa_identity.h"
 #include "fdl/freedreno_layout.h"
 #include "tu_acceleration_structure.h"
 #include "tu_clear_blit.h"
@@ -64,8 +65,12 @@ tu_device_get_cache_uuid(struct tu_physical_device *device, void *uuid)
    memset(uuid, 0, VK_UUID_SIZE);
    _mesa_blake3_init(&ctx);
 
-   if (!disk_cache_get_function_identifier((void *)tu_device_get_cache_uuid, &ctx))
-      return -1;
+   /* Keyed by the Mesa source this build compiles, not by the library's
+    * build-id: each rebuild of the same source links a different build-id,
+    * and every application's pipeline cache would be thrown away.
+    */
+   _mesa_blake3_update(&ctx, DROIDLOOM_MESA_IDENTITY,
+                       sizeof(DROIDLOOM_MESA_IDENTITY) - 1);
 
    _mesa_blake3_update(&ctx, &family, sizeof(family));
    _mesa_blake3_update(&ctx, &driver_flags, sizeof(driver_flags));
