-        stream->writeInt(cacheData.size());
-        if (cacheData.size() > 0)
-        {
-            stream->writeBool(contextVk->getFeatures().enablePipelineCacheDataCompression.enabled);
-            stream->writeBytes(cacheData);
-        }
+        stream->writeInt(static_cast<size_t>(0));
     }
 }
 
