turnip: bind Android swapchain images whose memory was deferred

Android's swapchain creates the images of a swapchain made with
VK_SWAPCHAIN_CREATE_DEFERRED_MEMORY_ALLOCATION_BIT_EXT without memory and
binds each one on its first acquire, passing the gralloc buffer as a
VkNativeBufferANDROID with memory VK_NULL_HANDLE. Turnip left that case as
UNREACHABLE, which a release build compiles out, and read through the null
memory. ANGLE asks for deferred allocation, so Wuthering Waves on ANGLE
crashed on its first eglSwapBuffers. Turnip now lays the image out the way
gralloc allocated the buffer, imports it and binds it, as it already does
for images created with a VkNativeBufferANDROID.

--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -1014,8 +1014,25 @@
 
    if (!mem) {
 #if DETECT_OS_ANDROID
-      /* TODO handle VkNativeBufferANDROID */
-      UNREACHABLE("VkBindImageMemoryInfo with no memory");
+      /* A deferred-allocation swapchain image gets its gralloc buffer here,
+       * on its first acquire. Lay the image out the way gralloc allocated
+       * the buffer, then bind the imported buffer; that bind comes back
+       * through this function with memory.
+       */
+      VkImageDrmFormatModifierExplicitCreateInfoEXT eci;
+      VkSubresourceLayout a_plane_layouts[TU_MAX_PLANE_COUNT];
+      result = vk_android_get_anb_layout_for_bind(
+         bind_info, &eci, a_plane_layouts, TU_MAX_PLANE_COUNT);
+      if (result != VK_SUCCESS)
+         return result;
+
+      result = TU_CALLX(device, tu_image_update_layout)(
+         device, image, eci.drmFormatModifier, a_plane_layouts);
+      if (result != VK_SUCCESS)
+         return result;
+
+      return vk_android_import_anb_for_bind(&device->vk, bind_info,
+                                            &image->vk);
 #else
       const VkBindImageMemorySwapchainInfoKHR *swapchain_info =
          vk_find_struct_const(bind_info->pNext,
