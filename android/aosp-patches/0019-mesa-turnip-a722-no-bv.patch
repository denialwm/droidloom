+/* Concurrent binning runs the binning pass on BV, which not every a7xx has. */
+static inline bool
+tu_device_allows_concurrent_binning(const struct tu_device *dev)
+{
+   return dev->physical_device->info->props.has_bv &&
+          dev->instance->allow_concurrent_binning;
+}
