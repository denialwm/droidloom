+angle::Result ContextVk::texEstimateMotion(const gl::Context *context,
+                                           gl::Texture *ref,
+                                           gl::Texture *target,
+                                           gl::Texture *output,
+                                           gl::Texture *mask)
+{
+    auto baseLevel = [](gl::Texture *texture) {
+        return gl::LevelIndex(texture->getTextureState().getEffectiveBaseLevel());
+    };
+    auto ready = [this](gl::Texture *texture) -> angle::Result {
+        return vk::GetImpl(texture)->ensureImageInitialized(this, ImageMipLevels::EnabledLevels);
+    };
+
+    ANGLE_TRY(ready(ref));
+    ANGLE_TRY(ready(target));
+    ANGLE_TRY(ready(output));
+
+    UtilsVk::EstimateMotionParameters params;
+    params.ref         = &vk::GetImpl(ref)->getImage();
+    params.refLevel    = baseLevel(ref);
+    params.target      = &vk::GetImpl(target)->getImage();
+    params.targetLevel = baseLevel(target);
+    params.output      = &vk::GetImpl(output)->getImage();
+    params.outputLevel = baseLevel(output);
+    params.width =
+        static_cast<uint32_t>(ref->getWidth(gl::TextureTarget::_2D, params.refLevel.get()));
+    params.height =
+        static_cast<uint32_t>(ref->getHeight(gl::TextureTarget::_2D, params.refLevel.get()));
+    if (mask != nullptr)
+    {
+        ANGLE_TRY(ready(mask));
+        params.mask      = &vk::GetImpl(mask)->getImage();
+        params.maskLevel = baseLevel(mask);
+    }
+
+    return mUtils.estimateMotion(this, params);
+}
