 }
 
+namespace
+{
+bool ValidateMotionEstimationTexture(const Context *context,
+                                     angle::EntryPoint entryPoint,
+                                     TextureID id,
+                                     GLenum sizedInternalFormat,
+                                     Extents *sizeOut)
+{
+    const Texture *texture = context->getTexture(id);
+    if (texture == nullptr)
+    {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kInvalidTextureName);
+        return false;
+    }
+    if (texture->getType() != TextureType::_2D)
+    {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kInvalidTextureTarget);
+        return false;
+    }
+    const GLuint level = texture->getTextureState().getEffectiveBaseLevel();
+    if (texture->getFormat(TextureTarget::_2D, level).info->sizedInternalFormat !=
+        sizedInternalFormat)
+    {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kInvalidFormat);
+        return false;
+    }
+    *sizeOut = Extents(static_cast<int>(texture->getWidth(TextureTarget::_2D, level)),
+                       static_cast<int>(texture->getHeight(TextureTarget::_2D, level)), 1);
+    return true;
+}
+
+bool ValidateTexEstimateMotionCommon(const Context *context,
+                                     angle::EntryPoint entryPoint,
+                                     TextureID refPacked,
+                                     TextureID targetPacked,
+                                     TextureID outputPacked,
+                                     Extents *outputSizeOut)
+{
+    Extents refSize, targetSize;
+    if (!ValidateMotionEstimationTexture(context, entryPoint, refPacked, GL_R8, &refSize) ||
+        !ValidateMotionEstimationTexture(context, entryPoint, targetPacked, GL_R8, &targetSize) ||
+        !ValidateMotionEstimationTexture(context, entryPoint, outputPacked, GL_RGBA16F,
+                                         outputSizeOut))
+    {
+        return false;
+    }
+
+    const int block = context->getCaps().motionEstimationSearchBlockSize;
+    if (refSize != targetSize || refSize.width % block != 0 || refSize.height % block != 0 ||
+        outputSizeOut->width != refSize.width / block ||
+        outputSizeOut->height != refSize.height / block)
+    {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kMotionEstimationTextureSize);
+        return false;
+    }
+    return true;
+}
+}  // anonymous namespace
+
+bool ValidateTexEstimateMotionQCOM(const Context *context,
+                                   angle::EntryPoint entryPoint,
+                                   TextureID refPacked,
+                                   TextureID targetPacked,
+                                   TextureID outputPacked)
+{
+    Extents outputSize;
+    return ValidateTexEstimateMotionCommon(context, entryPoint, refPacked, targetPacked,
+                                           outputPacked, &outputSize);
+}
+
+bool ValidateTexEstimateMotionRegionsQCOM(const Context *context,
+                                          angle::EntryPoint entryPoint,
+                                          TextureID refPacked,
+                                          TextureID targetPacked,
+                                          TextureID outputPacked,
+                                          TextureID maskPacked)
+{
+    Extents outputSize, maskSize;
+    if (!ValidateTexEstimateMotionCommon(context, entryPoint, refPacked, targetPacked,
+                                         outputPacked, &outputSize) ||
+        !ValidateMotionEstimationTexture(context, entryPoint, maskPacked, GL_R8UI, &maskSize))
+    {
+        return false;
+    }
+    if (maskSize != outputSize)
+    {
+        ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kMotionEstimationTextureSize);
+        return false;
+    }
+    return true;
+}
+
 }  // namespace gl
