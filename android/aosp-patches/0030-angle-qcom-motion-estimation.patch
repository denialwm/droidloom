diff --git a/src/libANGLE/renderer/vulkan/UtilsVk.h b/src/libANGLE/renderer/vulkan/UtilsVk.h
index 5c7ec30..7674112 100644
--- a/src/libANGLE/renderer/vulkan/UtilsVk.h
+++ b/src/libANGLE/renderer/vulkan/UtilsVk.h
@@ -234,6 +234,24 @@ class UtilsVk : angle::NonCopyable
         gl::FocalPoint focalPoints[gl::IMPLEMENTATION_MAX_FOCAL_POINTS];
     };
 
+    // GL_QCOM_motion_estimation: one motion vector per block of this many pixels on each axis.
+    static constexpr int kEstimateMotionBlockSize = 16;
+
+    struct EstimateMotionParameters
+    {
+        vk::ImageHelper *ref = nullptr;
