+angle::Result UtilsVk::estimateMotion(ContextVk *contextVk, const EstimateMotionParameters &params)
+{
+    vk::Renderer *renderer = contextVk->getRenderer();
+
+    ANGLE_TRY(ensureEstimateMotionResourcesInitialized(contextVk));
+
+    const uint32_t outputWidth  = params.width / kEstimateMotionBlockSize;
+    const uint32_t outputHeight = params.height / kEstimateMotionBlockSize;
+    if (outputWidth == 0 || outputHeight == 0)
+    {
+        return angle::Result::Continue;
+    }
+
+    // Views of the base level each input is read from.
+    auto initView = [contextVk](vk::ImageHelper *image, gl::LevelIndex level,
+                                vk::ImageView *viewOut) {
+        return image->initReinterpretedLayerImageView(
+            contextVk, gl::TextureType::_2D, VK_IMAGE_ASPECT_COLOR_BIT, gl::SwizzleState(),
+            viewOut, image->toVkLevel(level), 1, 0, 1, VK_IMAGE_USAGE_SAMPLED_BIT,
+            image->getActualFormatID(), GL_NONE);
+    };
+    vk::DeviceScoped<vk::ImageView> refView(contextVk->getDevice());
+    vk::DeviceScoped<vk::ImageView> targetView(contextVk->getDevice());
+    vk::DeviceScoped<vk::ImageView> maskView(contextVk->getDevice());
+    ANGLE_TRY(initView(params.ref, params.refLevel, &refView.get()));
+    ANGLE_TRY(initView(params.target, params.targetLevel, &targetView.get()));
+    if (params.mask != nullptr)
+    {
+        ANGLE_TRY(initView(params.mask, params.maskLevel, &maskView.get()));
+    }
+
+    // The shader writes RGBA16F texels into a buffer that is then copied into the output, so the
+    // output texture needs no storage usage.
+    vk::RendererScoped<vk::BufferHelper> vectorBuffer(renderer);
+    const VkDeviceSize bufferSize = static_cast<VkDeviceSize>(outputWidth) * outputHeight * 8;
+    ANGLE_TRY(contextVk->initBufferAllocation(
+        &vectorBuffer.get(), renderer->getDeviceLocalMemoryTypeIndex(),
+        static_cast<size_t>(bufferSize), renderer->getDefaultBufferAlignment(),
+        BufferUsageType::Static));
+
+    vk::CommandResources resources;
+    resources.onImageComputeShaderRead(VK_IMAGE_ASPECT_COLOR_BIT, params.ref);
+    if (params.target != params.ref)
+    {
+        resources.onImageComputeShaderRead(VK_IMAGE_ASPECT_COLOR_BIT, params.target);
+    }
+    if (params.mask != nullptr)
+    {
+        resources.onImageComputeShaderRead(VK_IMAGE_ASPECT_COLOR_BIT, params.mask);
+    }
+    resources.onImageTransferWrite(params.outputLevel, 1, 0, 1, VK_IMAGE_ASPECT_COLOR_BIT,
+                                   params.output);
+    resources.onBufferComputeShaderWrite(&vectorBuffer.get());
+
+    vk::OutsideRenderPassCommandBufferHelper *commandBufferHelper;
+    ANGLE_TRY(contextVk->getOutsideRenderPassCommandBufferHelper(resources, &commandBufferHelper));
+    vk::OutsideRenderPassCommandBuffer *commandBuffer = &commandBufferHelper->getCommandBuffer();
+
+    VkDescriptorSet descriptorSet;
+    ANGLE_TRY(allocateDescriptorSet(contextVk, commandBufferHelper, Function::EstimateMotion,
+                                    &descriptorSet));
+
+    const uint32_t imageCount           = params.mask != nullptr ? 3 : 2;
+    const uint32_t imageBindings[3]     = {kEstimateMotionRefBinding, kEstimateMotionTargetBinding,
+                                           kEstimateMotionMaskBinding};
+    VkDescriptorImageInfo imageInfos[3] = {};
+    imageInfos[0].imageView             = refView.get().getHandle();
+    imageInfos[0].imageLayout           = params.ref->getCurrentLayout(renderer);
+    imageInfos[1].imageView             = targetView.get().getHandle();
+    imageInfos[1].imageLayout           = params.target->getCurrentLayout(renderer);
+    if (params.mask != nullptr)
+    {
+        imageInfos[2].imageView   = maskView.get().getHandle();
+        imageInfos[2].imageLayout = params.mask->getCurrentLayout(renderer);
+    }
+
+    VkDescriptorBufferInfo bufferInfo = {};
+    bufferInfo.buffer                 = vectorBuffer.get().getBuffer().getHandle();
+    bufferInfo.offset                 = vectorBuffer.get().getOffset();
+    bufferInfo.range                  = vectorBuffer.get().getSize();
+
+    VkWriteDescriptorSet writeInfos[4] = {};
+    for (uint32_t i = 0; i < imageCount; ++i)
+    {
+        writeInfos[i].sType           = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        writeInfos[i].dstSet          = descriptorSet;
+        writeInfos[i].dstBinding      = imageBindings[i];
+        writeInfos[i].descriptorCount = 1;
+        writeInfos[i].descriptorType  = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+        writeInfos[i].pImageInfo      = &imageInfos[i];
+    }
+    VkWriteDescriptorSet &bufferWrite = writeInfos[imageCount];
+    bufferWrite.sType                 = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    bufferWrite.dstSet                = descriptorSet;
+    bufferWrite.dstBinding            = kEstimateMotionOutputBinding;
+    bufferWrite.descriptorCount       = 1;
+    bufferWrite.descriptorType        = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    bufferWrite.pBufferInfo           = &bufferInfo;
+
+    vkUpdateDescriptorSets(contextVk->getDevice(), imageCount + 1, writeInfos, 0, nullptr);
+
+    const uint32_t flags = params.mask != nullptr ? EstimateMotion_comp::kUseMask : 0;
+    vk::ShaderModulePtr shader;
+    ANGLE_TRY(contextVk->getShaderLibrary().getEstimateMotion_comp(contextVk, flags, &shader));
+
+    EstimateMotionShaderParams shaderParams;
+    shaderParams.imageSize[0] = static_cast<int32_t>(params.width);
+    shaderParams.imageSize[1] = static_cast<int32_t>(params.height);
+    shaderParams.outputWidth  = outputWidth;
+
+    ANGLE_TRY(setupComputeProgram(contextVk, Function::EstimateMotion, shader,
+                                  &mEstimateMotion[flags], descriptorSet, &shaderParams,
+                                  sizeof(shaderParams), commandBufferHelper));
+    commandBuffer->dispatch(outputWidth, outputHeight, 1);
+
+    // Copy the vectors into the output.
+    VkMemoryBarrier memoryBarrier = {};
+    memoryBarrier.sType           = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    memoryBarrier.srcAccessMask   = VK_ACCESS_SHADER_WRITE_BIT;
+    memoryBarrier.dstAccessMask   = VK_ACCESS_TRANSFER_READ_BIT;
+    commandBuffer->memoryBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                 VK_PIPELINE_STAGE_TRANSFER_BIT, memoryBarrier);
+
+    VkBufferImageCopy region               = {};
+    region.bufferOffset                    = vectorBuffer.get().getOffset();
+    region.bufferRowLength                 = outputWidth;
+    region.bufferImageHeight               = outputHeight;
+    region.imageSubresource.aspectMask     = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.imageSubresource.mipLevel       = params.output->toVkLevel(params.outputLevel).get();
+    region.imageSubresource.baseArrayLayer = 0;
+    region.imageSubresource.layerCount     = 1;
+    region.imageExtent.width               = outputWidth;
+    region.imageExtent.height              = outputHeight;
+    region.imageExtent.depth               = 1;
+    commandBuffer->copyBufferToImage(vectorBuffer.get().getBuffer().getHandle(),
+                                     params.output->getImage(),
+                                     params.output->getCurrentLayout(renderer), 1, &region);
+
+    vk::ImageView refViewObject    = refView.release();
+    vk::ImageView targetViewObject = targetView.release();
+    contextVk->addGarbage(&refViewObject);
+    contextVk->addGarbage(&targetViewObject);
+    if (params.mask != nullptr)
+    {
+        vk::ImageView maskViewObject = maskView.release();
+        contextVk->addGarbage(&maskViewObject);
+    }
+
+    return angle::Result::Continue;
+}
