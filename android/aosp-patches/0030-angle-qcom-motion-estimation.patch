diff --git a/src/libANGLE/renderer/vulkan/shaders/src/EstimateMotion.comp b/src/libANGLE/renderer/vulkan/shaders/src/EstimateMotion.comp
new file mode 100644
index 0000000..5431299
--- /dev/null
+++ b/src/libANGLE/renderer/vulkan/shaders/src/EstimateMotion.comp
@@ -0,0 +1,173 @@
+//
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// EstimateMotion.comp: GL_QCOM_motion_estimation by block matching.  One workgroup per block
+// finds where the block of the reference image went in the target image: a search every other
+// pixel over +-16 pixels, a full-resolution search around the best match, and a parabola fit
+// for the sub-pixel part.  Small motions that barely beat no motion count as no motion.
+
+#version 450 core
+
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform PushConstants
+{
+    ivec2 imageSize;
+    uint outputWidth;
+} params;
+
+layout(set = 0, binding = 0) uniform texture2D refImage;
+layout(set = 0, binding = 1) uniform texture2D targetImage;
+layout(set = 0, binding = 2) buffer Output
+{
+    uvec2 vectors[];
+};
+#if UseMask
+layout(set = 0, binding = 3) uniform utexture2D maskImage;
+#endif
+
+const int kBlock         = 16;
+const int kRange         = 16;
+const int kWindow        = kBlock + 2 * kRange;
+const int kCoarseSteps   = kRange + 1;
+const int kThreads       = 64;
+// Cost of one pixel of motion, in the units of a full-block SAD of normalized texels.
+const float kMotionCost  = 0.02;
+
+shared float refBlock[kBlock * kBlock];
+shared float window[kWindow * kWindow];
+shared uint bestCoarse;
+shared float fineCost[26];
+
+float blockSad(ivec2 offset, int step)
+{
+    float sad = 0.0;
+    for (int y = 0; y < kBlock; y += step)
+    {
+        for (int x = 0; x < kBlock; x += step)
+        {
+            sad += abs(refBlock[y * kBlock + x] - window[(y + offset.y) * kWindow + x + offset.x]);
+        }
+    }
+    return sad;
+}
+
+float motionCost(ivec2 offset)
+{
+    ivec2 motion = offset - ivec2(kRange);
+    return kMotionCost * float(abs(motion.x) + abs(motion.y));
+}
+
+void main()
+{
+    ivec2 block    = ivec2(gl_WorkGroupID.xy);
+    uint outIndex  = uint(block.y) * params.outputWidth + uint(block.x);
+    uint thread    = gl_LocalInvocationIndex;
+
+#if UseMask
+    if (texelFetch(maskImage, block, 0).r == 0u)
+    {
+        if (thread == 0u)
+        {
+            vectors[outIndex] = uvec2(0u);
+        }
+        return;
+    }
+#endif
+
+    ivec2 origin   = block * kBlock;
+    ivec2 maxCoord = params.imageSize - 1;
+    for (uint i = thread; i < uint(kBlock * kBlock); i += kThreads)
+    {
+        ivec2 p     = ivec2(int(i) % kBlock, int(i) / kBlock);
+        refBlock[i] = texelFetch(refImage, origin + p, 0).r;
+    }
+    for (uint i = thread; i < uint(kWindow * kWindow); i += kThreads)
+    {
+        ivec2 p   = ivec2(int(i) % kWindow, int(i) / kWindow) + origin - ivec2(kRange);
+        window[i] = texelFetch(targetImage, clamp(p, ivec2(0), maxCoord), 0).r;
+    }
+    if (thread == 0u)
+    {
+        bestCoarse = 0xFFFFFFFFu;
+    }
+    barrier();
+
+    // Coarse search: every other offset, every other pixel.  The cost goes in the high bits and
+    // the candidate in the low 12, so atomicMin keeps the cheapest.
+    for (uint c = thread; c < uint(kCoarseSteps * kCoarseSteps); c += kThreads)
+    {
+        ivec2 offset = ivec2(int(c) % kCoarseSteps, int(c) / kCoarseSteps) * 2;
+        float cost   = blockSad(offset, 2) * 4.0 + motionCost(offset);
+        uint key     = (min(uint(cost * 1024.0), 0xFFFFFu) << 12) | c;
+        atomicMin(bestCoarse, key);
+    }
+    barrier();
+
+    uint coarseIndex   = bestCoarse & 0xFFFu;
+    ivec2 coarseOffset = ivec2(int(coarseIndex) % kCoarseSteps, int(coarseIndex) / kCoarseSteps) * 2;
+
+    // Fine search: the 5x5 offsets around the coarse match, every pixel.  Thread 25 measures
+    // no motion.
+    if (thread < 25u)
+    {
+        ivec2 offset = coarseOffset + ivec2(int(thread) % 5, int(thread) / 5) - ivec2(2);
+        offset       = clamp(offset, ivec2(0), ivec2(2 * kRange));
+        fineCost[thread] = blockSad(offset, 1) + motionCost(offset);
+    }
+    else if (thread == 25u)
+    {
+        fineCost[25] = blockSad(ivec2(kRange), 1);
+    }
+    barrier();
+
+    if (thread != 0u)
+    {
+        return;
+    }
+
+    int best = 12;
+    for (int i = 0; i < 25; ++i)
+    {
+        if (fineCost[i] < fineCost[best])
+        {
+            best = i;
+        }
+    }
+
+    vec2 motion = vec2(0.0);
+    if (fineCost[best] < fineCost[25] * 0.98 - 0.25)
+    {
+        ivec2 bestXY = ivec2(best % 5, best / 5);
+        ivec2 offset = clamp(coarseOffset + bestXY - ivec2(2), ivec2(0), ivec2(2 * kRange));
+        motion       = vec2(offset - ivec2(kRange));
+
+        // Sub-pixel: fit a parabola through the best cost and its neighbors on each axis.
+        if (bestXY.x > 0 && bestXY.x < 4)
+        {
+            float l     = fineCost[best - 1];
+            float r     = fineCost[best + 1];
+            float curve = l - 2.0 * fineCost[best] + r;
+            if (curve > 0.0)
+            {
+                motion.x += clamp(0.5 * (l - r) / curve, -0.5, 0.5);
+            }
+        }
+        if (bestXY.y > 0 && bestXY.y < 4)
+        {
+            float u     = fineCost[best - 5];
+            float d     = fineCost[best + 5];
+            float curve = u - 2.0 * fineCost[best] + d;
+            if (curve > 0.0)
+            {
+                motion.y += clamp(0.5 * (u - d) / curve, -0.5, 0.5);
+            }
+        }
+    }
+
+    vectors[outIndex] = uvec2(packHalf2x16(motion), 0u);
+}
