+// The host rejects with EOPNOTSUPP when it cannot place an arrangement at all,
+// such as a layer edge off its logical pixel grid. Any other rejection is
+// transient and falls back for one composition.
+constexpr int32_t kUnplaceable = -95;
+
+// A scene is the configure serial, width and height, then 16 words per layer
+// starting with its id, buffer and frame. Its shape leaves out the content.
+std::vector<uint64_t> sceneShape(std::vector<uint64_t> scene) {
+    for (size_t i = 3; i + 2 < scene.size(); i += 16) scene[i + 1] = scene[i + 2] = 0;
+    return scene;
+}
