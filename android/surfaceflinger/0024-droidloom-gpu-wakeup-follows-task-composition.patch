+// GPU-composed frames start up to 3 ms before the late wakeup, so RenderEngine
+// finishes before the host latches. Composer puts the late wakeup 2 ms before
+// the latch; the earlier wakeup stays at least 1 ms after the previous latch.
+std::chrono::nanoseconds sfEarlyGpuLead(nsecs_t vsyncDuration) {
+    return std::clamp(std::chrono::nanoseconds(vsyncDuration) - 3ms,
+                      std::chrono::nanoseconds(0), std::chrono::nanoseconds(3ms));
+}
