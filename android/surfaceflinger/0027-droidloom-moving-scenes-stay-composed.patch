+// Switching between composition and direct placement shows on screen, and a
+// moving scene can switch on every frame as its edges cross the pixel grid.
+// Once composed, a scene asks for direct placement again only after its shape
+// has held for kSettleNs.
+constexpr int64_t kSettleNs = 100'000'000;
+class ShapeSettle {
+    std::vector<uint64_t> mShape;
+    int64_t mSince = 0;
+public:
+    bool settled(std::vector<uint64_t> shape, int64_t now) {
+        if (shape != mShape) {
+            mShape = std::move(shape);
+            mSince = now;
+        }
+        return now - mSince >= kSettleNs;
+    }
+};
