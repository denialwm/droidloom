<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A Droidloom local display represents an app window, never a mirror of
      Android's bootstrap display. LocalDisplayAdapter converts this setting
      into FLAG_OWN_CONTENT_ONLY, which makes DisplayManager declare every
      Composer-created display capable of hosting tasks.
    -->
    <bool name="config_localDisplaysMirrorContent">false</bool>
    <!-- The host draws the wallpaper; Android's never reaches a display.
         Waiting for it at boot only ends in WindowManager's 30 s timeout. -->
    <bool name="config_checkWallpaperAtBoot">false</bool>
    <!-- Linux owns whole-host suspend. Android still defers its own background
         work when the host display is off; the cell has no motion sensor. -->
    <bool name="config_enableAutoPowerModes">true</bool>
    <bool name="config_autoPowerModeUseMotionSensor">false</bool>
    <!-- The host mixer owns loudness: every Android stream stays at full
         scale, and Android ignores volume keys and apps that set a volume. -->
    <bool name="config_useFixedVolume">true</bool>
</resources>
