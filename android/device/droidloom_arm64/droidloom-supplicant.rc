# servicemanager starts the supplicant when the framework asks for it, as Wi-Fi
# turns on. terminate() exits it as Wi-Fi turns off; oneway keeps it down.
service wpa_supplicant /vendor/bin/hw/android.hardware.wifi.supplicant-service.droidloom
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    class main
    user wifi
    group wifi
    disabled
    oneway
    stdio_to_kmsg
