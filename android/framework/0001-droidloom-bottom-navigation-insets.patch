 class InsetsPolicy {
 
+    // This existing read-only product marker identifies Droidloom's task windows.
+    // Keep ordinary Android products on their stock system-bar policy.
+    @VisibleForTesting
+    boolean mDroidloomSystemBars = SystemProperties.getBoolean(
+            "ro.vendor.droidloom.surfaceflinger_tasks", false);
+
     public static final int CONTROLLABLE_TYPES = WindowInsets.Type.statusBars()
             | WindowInsets.Type.navigationBars()
             | WindowInsets.Type.ime();
@@ -352,7 +359,20 @@ class InsetsPolicy {
         }
         state = adjustVisibilityForIme(target, state, state == originalState);
         state = mPolicy.replaceInsetsSourcesIfNeeded(state, state == originalState);
-        return adjustInsetsForRoundedCorners(target.mToken, state, state == originalState);
+        state = adjustInsetsForRoundedCorners(target.mToken, state, state == originalState);
+        // Apply after freeform filtering, transient visibility and IME adjustments.
+        // Host system bars are always present and has no Android control leash.
+        if (mDroidloomSystemBars && target.mActivityRecord != null) {
+            state = DroidloomSystemBarInsets.apply(state, target.getConfiguration().densityDpi,
+                    droidloomKeyboardInset(target.getTask()));
+        }
+        return state;
+    }
+
+    /** How much of the task the host's on-screen keyboard covers, in pixels. */
+    private int droidloomKeyboardInset(Task task) {
+        final DroidloomTaskBackend tasks = mDisplayContent.mWmService.mAtmService.mDroidloomTasks;
+        return tasks == null || task == null ? 0 : tasks.keyboardInset(task);
     }
 
